{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:onglet(ai-drawing|analyze|author-rights|batch|clean-metadata|color-palette|convert|crop|drop-shadow|editor|favicons|filters|glow-effect|gradient|pricing|projects|remove-background|resize|responsive-images|rotate-flip|social-media|vectorize|watermark)",
      "destination": "/index.html"
    }
  ]
}
