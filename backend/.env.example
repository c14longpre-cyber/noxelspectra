# Copy to .env for local dev. On Railway, set these in the project's Variables tab —
# PORT is provided automatically by Railway at runtime, no need to set it there.

PORT=5000

# Comma-separated list of allowed frontend origins for CORS once deployed
# (e.g. https://noxelspectra.com). Leave unset for local dev (all origins allowed).
ALLOWED_ORIGINS=

# ── Comptes, forfaits et dessin IA (facultatifs : sans eux, seuls les outils gratuits fonctionnent) ──
# Même projet Supabase que NOXEL SEO et NOXEL FORGE (table users partagée) ; migration :
# backend/supabase/20261031_spectra_comptes.sql
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Secret propre à SPECTRA (jamais celui de FORGE ou SEO) : openssl rand -hex 32
SPECTRA_JWT_SECRET=
# L'API doit être servie sur api.noxelspectra.com (domaine personnalisé Railway) pour que le cookie
# de session soit accepté par Safari ; le cookie est posé sur .noxelspectra.com (app + vidéo)
BACKEND_PUBLIC_URL=https://api.noxelspectra.com
FRONTEND_URL=https://app.noxelspectra.com
COOKIE_DOMAIN=.noxelspectra.com
# Connexion Google : même ID client que NOXEL SEO / FORGE, avec https://app.noxelspectra.com
# ajouté aux « origines JavaScript autorisées » dans Google Cloud
GOOGLE_CLIENT_ID=
# Courriels (lien magique, confirmation) : même compte Resend que FORGE
RESEND_API_KEY=
EMAIL_FROM=NOXEL SPECTRA <noreply@noxelseo.com>

# Stripe (prix en CAD créés dans le tableau de bord ; webhook : https://api.noxelspectra.com/api/billing/webhook)
STRIPE_SECRET_KEY=
SPECTRA_STRIPE_WEBHOOK_SECRET=
SPECTRA_PRICE_SILVER_MONTHLY=
SPECTRA_PRICE_SILVER_ANNUAL=
SPECTRA_PRICE_GOLD_MONTHLY=
SPECTRA_PRICE_GOLD_ANNUAL=
SPECTRA_PRICE_PLATINUM_MONTHLY=
SPECTRA_PRICE_PLATINUM_ANNUAL=
SPECTRA_PRICE_DIAMOND_MONTHLY=
SPECTRA_PRICE_DIAMOND_ANNUAL=
# Paquet de 50 crédits de dessin IA, paiement unique de 5 $ CA
SPECTRA_PRICE_CREDITS=
# Configuration du portail client propre à SPECTRA (bpc_…), facultative
SPECTRA_PORTAL_CONFIG=

# Dessin IA : FLUX.2 [pro] de Black Forest Labs (clé sur https://dashboard.bfl.ai)
BFL_API_KEY=
